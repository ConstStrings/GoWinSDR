`pragma protect end_protected
module fifo_rf_databuf (
  n9784_4,
  tx_byte_fifo_rd_en,
  bb_symbol_clk,
  bb_byte_clk_div,
  rf_tx_data_Z,
  tx_byte_fifo_full,
  u_rf_process_0,
  tx_byte_fifo_data
)
;
input n9784_4;
input tx_byte_fifo_rd_en;
input bb_symbol_clk;
input [1:1] bb_byte_clk_div;
input [7:0] rf_tx_data_Z;
output tx_byte_fifo_full;
output u_rf_process_0;
output [7:0] tx_byte_fifo_data;
wire VCC;
wire GND;
  \~fifo.fifo_rf_databuf  fifo_inst (
    .n9784_4(n9784_4),
    .tx_byte_fifo_rd_en(tx_byte_fifo_rd_en),
    .bb_symbol_clk(bb_symbol_clk),
    .bb_byte_clk_div(bb_byte_clk_div[1]),
    .rf_tx_data_Z(rf_tx_data_Z[7:0]),
    .tx_byte_fifo_full(tx_byte_fifo_full),
    .u_rf_process_0(u_rf_process_0),
    .tx_byte_fifo_data(tx_byte_fifo_data[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* fifo_rf_databuf */
module rf_dqpsk_encoder (
  bb_symbol_clk,
  n7_6_3,
  u_rf_process_1_4,
  fifo_i_almost_full,
  fifo_q_almost_full,
  tx_byte_hold,
  symbol_tick,
  qpsk_i_out_Z_3,
  qpsk_i_out_Z_10,
  qpsk_i_out_Z_11,
  qpsk_q_out_Z,
  nibble_idx
)
;
input bb_symbol_clk;
input n7_6_3;
input u_rf_process_1_4;
input fifo_i_almost_full;
input fifo_q_almost_full;
input [7:0] tx_byte_hold;
output symbol_tick;
output qpsk_i_out_Z_3;
output qpsk_i_out_Z_10;
output qpsk_i_out_Z_11;
output [11:10] qpsk_q_out_Z;
output [1:0] nibble_idx;
wire tx_data_iq_1_6;
wire tx_data_iq_1_7;
wire tx_data_iq_0_6;
wire tx_data_iq_0_7;
wire n77_4;
wire n85_4;
wire n11_6;
wire n78_5;
wire n84_5;
wire n117_6;
wire n12_10;
wire nibble_idx_0_10;
wire carrier_polarity;
wire [1:0] tx_data_iq_diff;
wire [1:0] prev_sym;
wire [11:3] qpsk_i;
wire [11:10] qpsk_q;
wire [1:0] tx_data_iq;
wire VCC;
wire GND;
  LUT4 tx_data_iq_diff_1_s27 (
    .F(tx_data_iq_diff[1]),
    .I0(tx_data_iq[0]),
    .I1(tx_data_iq[1]),
    .I2(prev_sym[1]),
    .I3(prev_sym[0]) 
);
defparam tx_data_iq_diff_1_s27.INIT=16'h5C3A;
  LUT4 tx_data_iq_diff_0_s27 (
    .F(tx_data_iq_diff[0]),
    .I0(tx_data_iq[0]),
    .I1(tx_data_iq[1]),
    .I2(prev_sym[1]),
    .I3(prev_sym[0]) 
);
defparam tx_data_iq_diff_0_s27.INIT=16'h35AC;
  LUT3 tx_data_iq_1_s6 (
    .F(tx_data_iq_1_6),
    .I0(tx_byte_hold[7]),
    .I1(tx_byte_hold[5]),
    .I2(nibble_idx[0]) 
);
defparam tx_data_iq_1_s6.INIT=8'hCA;
  LUT3 tx_data_iq_1_s7 (
    .F(tx_data_iq_1_7),
