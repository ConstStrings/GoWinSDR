module GMII2RGMII (
  eth_transceiver_u_15_3,
  eth_transceiver_u_11_3,
  RGMII_GTXCLK_d,
  eth_transceiver_u_14_3,
  eth_transceiver_u_10_3,
  eth_transceiver_u_13_3,
  eth_transceiver_u_9_3,
  eth_transceiver_u_12_3,
  eth_transceiver_u_8_3,
  RGMII_TXD_d
)
;
input eth_transceiver_u_15_3;
input eth_transceiver_u_11_3;
input RGMII_GTXCLK_d;
input eth_transceiver_u_14_3;
input eth_transceiver_u_10_3;
