module fifo_rf_databuf (
  n708_4,
  tx_byte_fifo_rd_en,
  bb_symbol_clk,
  u_rf_process_7,
  u_rf_process_6,
  u_rf_process_5,
  u_rf_process_4,
  u_rf_process_3,
  u_rf_process_2,
  u_rf_process_1,
  u_rf_process_0,
  bb_byte_clk_div,
  tx_byte_fifo_full,
  tx_byte_fifo_empty,
  tx_byte_fifo_data
)
;
input n708_4;
input tx_byte_fifo_rd_en;
input bb_symbol_clk;
input u_rf_process_7;
input u_rf_process_6;
input u_rf_process_5;
input u_rf_process_4;
input u_rf_process_3;
input u_rf_process_2;
