module gardner_ted (
  I_y_19_6,
  rf_rx_clk,
  Q_y_19_6,
  n6_6,
  strobe_delay,
  led_d_Z,
  u_rf_process_8_2,
  dqpsk_rx_i_Z,
  dqpsk_rx_q_Z
)
;
input I_y_19_6;
input rf_rx_clk;
input Q_y_19_6;
input n6_6;
input [2:2] strobe_delay;
input [1:1] led_d_Z;
output u_rf_process_8_2;
output [11:11] dqpsk_rx_i_Z;
output [11:11] dqpsk_rx_q_Z;
wire samp_flag;
wire n112_7;
wire n109_7;
wire n108_7;
wire n107_7;
wire n106_7;
wire samp_flag_4;
wire n111_8;
wire n108_8;
wire samp_flag_5;
wire samp_flag_6;
wire n1067_5;
wire n110_9;
wire n111_10;
wire n113_9;
wire [7:0] strobe_cnt;
wire VCC;
wire GND;
  LUT2 samp_flag_s0 (
    .F(samp_flag),
    .I0(strobe_cnt[0]),
    .I1(samp_flag_4) 
);
defparam samp_flag_s0.INIT=4'h4;
  LUT3 n112_s2 (
    .F(n112_7),
    .I0(samp_flag_4),
    .I1(strobe_cnt[0]),
    .I2(strobe_cnt[1]) 
);
defparam n112_s2.INIT=8'h14;
  LUT4 n109_s2 (
    .F(n109_7),
    .I0(strobe_cnt[2]),
    .I1(strobe_cnt[3]),
    .I2(n111_8),
