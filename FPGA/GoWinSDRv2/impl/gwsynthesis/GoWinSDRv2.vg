module Gowin_PLL_rfclk_MOD (
  tx_clk_out_p_d,
  rRstOut,
  rMdInc,
  rMdOpc,
  rMdDOut,
  pll_lock,
  rf_rx_clk,
  wMdQOut
)
;
input tx_clk_out_p_d;
input rRstOut;
input rMdInc;
input [1:0] rMdOpc;
input [7:0] rMdDOut;
