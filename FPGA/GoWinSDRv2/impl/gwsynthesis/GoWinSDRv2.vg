  fifo_q_almost_full,
  tx_byte_hold,
  symbol_tick,
  qpsk_i_out_Z_3,
  qpsk_i_out_Z_10,
  qpsk_i_out_Z_11,
  qpsk_q_out_Z,
  nibble_idx
)
