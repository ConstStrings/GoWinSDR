    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* fifo_rf_databuf */
module rf_dqpsk_encoder (
  bb_symbol_clk,
  n6_6,
  tx_byte_held,
  fifo_i_almost_full,
  fifo_q_almost_full,
  tx_byte_hold,
  symbol_tick,
  qpsk_i_out_Z_3,
  qpsk_i_out_Z_10,
  qpsk_i_out_Z_11,
  qpsk_q_out_Z,
  nibble_idx
)
;
input bb_symbol_clk;
input n6_6;
input tx_byte_held;
input fifo_i_almost_full;
input fifo_q_almost_full;
input [7:0] tx_byte_hold;
output symbol_tick;
output qpsk_i_out_Z_3;
output qpsk_i_out_Z_10;
output qpsk_i_out_Z_11;
output [11:10] qpsk_q_out_Z;
output [1:0] nibble_idx;
wire tx_data_iq_1_6;
wire tx_data_iq_1_7;
wire tx_data_iq_0_6;
wire tx_data_iq_0_7;
wire n78_3;
wire n84_3;
wire n11_6;
wire n77_6;
wire n85_6;
wire n117_6;
wire n12_10;
wire nibble_idx_0_10;
wire carrier_polarity;
wire [1:0] tx_data_iq_diff;
wire [1:0] prev_sym;
wire [11:3] qpsk_i;
wire [11:10] qpsk_q;
wire [1:0] tx_data_iq;
wire VCC;
wire GND;
  LUT4 tx_data_iq_diff_1_s27 (
    .F(tx_data_iq_diff[1]),
    .I0(tx_data_iq[0]),
    .I1(tx_data_iq[1]),
    .I2(prev_sym[1]),
    .I3(prev_sym[0]) 
);
defparam tx_data_iq_diff_1_s27.INIT=16'h5C3A;
  LUT4 tx_data_iq_diff_0_s27 (
    .F(tx_data_iq_diff[0]),
    .I0(tx_data_iq[0]),
    .I1(tx_data_iq[1]),
    .I2(prev_sym[1]),
    .I3(prev_sym[0]) 
);
defparam tx_data_iq_diff_0_s27.INIT=16'h35AC;
  LUT3 tx_data_iq_1_s6 (
    .F(tx_data_iq_1_6),
    .I0(tx_byte_hold[7]),
    .I1(tx_byte_hold[5]),
    .I2(nibble_idx[0]) 
);
defparam tx_data_iq_1_s6.INIT=8'hCA;
  LUT3 tx_data_iq_1_s7 (
    .F(tx_data_iq_1_7),
    .I0(tx_byte_hold[3]),
    .I1(tx_byte_hold[1]),
    .I2(nibble_idx[0]) 
);
defparam tx_data_iq_1_s7.INIT=8'hCA;
  LUT3 tx_data_iq_0_s6 (
    .F(tx_data_iq_0_6),
    .I0(tx_byte_hold[6]),
    .I1(tx_byte_hold[4]),
    .I2(nibble_idx[0]) 
);
defparam tx_data_iq_0_s6.INIT=8'hCA;
  LUT3 tx_data_iq_0_s7 (
    .F(tx_data_iq_0_7),
    .I0(tx_byte_hold[2]),
    .I1(tx_byte_hold[0]),
    .I2(nibble_idx[0]) 
);
defparam tx_data_iq_0_s7.INIT=8'hCA;
  LUT3 n78_s0 (
    .F(n78_3),
    .I0(carrier_polarity),
    .I1(tx_data_iq_diff[1]),
    .I2(tx_byte_held) 
);
defparam n78_s0.INIT=8'h3A;
  LUT3 n84_s0 (
    .F(n84_3),
    .I0(carrier_polarity),
    .I1(tx_data_iq_diff[0]),
    .I2(tx_byte_held) 
);
defparam n84_s0.INIT=8'h3A;
  LUT3 n11_s1 (
    .F(n11_6),
    .I0(nibble_idx[0]),
    .I1(nibble_idx[1]),
    .I2(tx_byte_held) 
);
defparam n11_s1.INIT=8'h60;
  LUT3 n77_s2 (
    .F(n77_6),
    .I0(carrier_polarity),
    .I1(tx_data_iq_diff[1]),
    .I2(tx_byte_held) 
);
defparam n77_s2.INIT=8'hC5;
  LUT3 n85_s2 (
    .F(n85_6),
    .I0(carrier_polarity),
    .I1(tx_data_iq_diff[0]),
    .I2(tx_byte_held) 
);
defparam n85_s2.INIT=8'hC5;
  LUT4 n117_s2 (
    .F(n117_6),
    .I0(tx_byte_held),
    .I1(fifo_i_almost_full),
    .I2(fifo_q_almost_full),
    .I3(carrier_polarity) 
);
defparam n117_s2.INIT=16'hFE01;
  LUT3 symbol_tick_s2 (
    .F(symbol_tick),
    .I0(tx_byte_held),
    .I1(fifo_i_almost_full),
    .I2(fifo_q_almost_full) 
);
defparam symbol_tick_s2.INIT=8'h02;
  LUT4 n12_s4 (
    .F(n12_10),
    .I0(tx_byte_held),
    .I1(fifo_i_almost_full),
    .I2(fifo_q_almost_full),
    .I3(nibble_idx[0]) 
);
defparam n12_s4.INIT=16'hFC02;
  LUT2 nibble_idx_0_s4 (
    .F(nibble_idx_0_10),
    .I0(fifo_i_almost_full),
    .I1(fifo_q_almost_full) 
);
defparam nibble_idx_0_s4.INIT=4'h1;
  DFFCE prev_sym_1_s0 (
    .Q(prev_sym[1]),
    .D(tx_data_iq_diff[1]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(symbol_tick) 
);
  DFFCE prev_sym_0_s0 (
    .Q(prev_sym[0]),
    .D(tx_data_iq_diff[0]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(symbol_tick) 
);
  DFFCE qpsk_i_11_s0 (
    .Q(qpsk_i[11]),
    .D(n78_3),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE qpsk_i_10_s0 (
    .Q(qpsk_i[10]),
    .D(n77_6),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE qpsk_i_3_s0 (
    .Q(qpsk_i[3]),
    .D(VCC),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE qpsk_q_11_s0 (
    .Q(qpsk_q[11]),
    .D(n84_3),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE qpsk_q_10_s0 (
    .Q(qpsk_q[10]),
    .D(n85_6),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE carrier_polarity_s0 (
    .Q(carrier_polarity),
    .D(n117_6),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE qpsk_i_out_11_s0 (
    .Q(qpsk_i_out_Z_11),
    .D(qpsk_i[11]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE qpsk_i_out_10_s0 (
    .Q(qpsk_i_out_Z_10),
    .D(qpsk_i[10]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE qpsk_i_out_3_s0 (
    .Q(qpsk_i_out_Z_3),
    .D(qpsk_i[3]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE qpsk_q_out_11_s0 (
    .Q(qpsk_q_out_Z[11]),
    .D(qpsk_q[11]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE qpsk_q_out_10_s0 (
    .Q(qpsk_q_out_Z[10]),
    .D(qpsk_q[10]),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
  DFFCE nibble_idx_1_s0 (
    .Q(nibble_idx[1]),
    .D(n11_6),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(nibble_idx_0_10) 
);
  DFFCE nibble_idx_0_s3 (
    .Q(nibble_idx[0]),
    .D(n12_10),
    .CLK(bb_symbol_clk),
    .CLEAR(n6_6),
    .CE(VCC) 
);
defparam nibble_idx_0_s3.INIT=1'b0;
  MUX2_LUT5 tx_data_iq_1_s5 (
    .O(tx_data_iq[1]),
    .I0(tx_data_iq_1_6),
    .I1(tx_data_iq_1_7),
    .S0(nibble_idx[1]) 
);
  MUX2_LUT5 tx_data_iq_0_s5 (
    .O(tx_data_iq[0]),
    .I0(tx_data_iq_0_6),
    .I1(tx_data_iq_0_7),
    .S0(nibble_idx[1]) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* rf_dqpsk_encoder */
