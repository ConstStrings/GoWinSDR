module Gowin_PLL_rfclk_MOD (
  tx_clk_out_p_d,
  rRstOut,
  rMdInc,
  rMdOpc,
  rMdDOut,
  pll_lock,
  rf_rx_clk,
  wMdQOut
)
;
input tx_clk_out_p_d;
input rRstOut;
input rMdInc;
input [1:0] rMdOpc;
input [7:0] rMdDOut;
output pll_lock;
output rf_rx_clk;
output [7:0] wMdQOut;
wire clkout1;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLLA PLLA_inst (
    .MDRDO(wMdQOut[7:0]),
    .LOCK(pll_lock),
    .CLKOUT0(rf_rx_clk),
    .CLKOUT1(clkout1),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(tx_clk_out_p_d),
    .CLKFB(GND),
    .RESET(rRstOut),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}),
    .MDCLK(tx_clk_out_p_d),
    .MDOPC(rMdOpc[1:0]),
    .MDAINC(rMdInc),
    .MDWDI(rMdDOut[7:0]) 
);
defparam PLLA_inst.CLK0_IN_SEL=1'b0;
defparam PLLA_inst.CLK0_OUT_SEL=1'b0;
defparam PLLA_inst.CLK1_IN_SEL=1'b0;
defparam PLLA_inst.CLK1_OUT_SEL=1'b0;
defparam PLLA_inst.CLK2_IN_SEL=1'b0;
