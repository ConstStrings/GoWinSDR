wire VCC;
wire GND;
  PLLA PLLA_inst (
    .MDRDO(wMdQOut[7:0]),
    .LOCK(pll_lock),
    .CLKOUT0(data_clk),
    .CLKOUT1(clkout1),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(tx_clk_out_p_d),
    .CLKFB(GND),
    .RESET(rRstOut),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
