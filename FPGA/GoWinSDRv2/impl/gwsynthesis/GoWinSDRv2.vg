`pragma protect end_protected
module fifo_rf (
  fir_valid_in,
  rx_clk_in_p_d,
  bb_symbol_clk,
  qpsk_i_out_Z_3,
  qpsk_i_out_Z_10,
  qpsk_i_out_Z_11,
  fifo_i_almost_full,
  fifo_i_empty,
  fifo_i_dout
)
;
input fir_valid_in;
input rx_clk_in_p_d;
input bb_symbol_clk;
input qpsk_i_out_Z_3;
input qpsk_i_out_Z_10;
input qpsk_i_out_Z_11;
output fifo_i_almost_full;
output fifo_i_empty;
output [11:0] fifo_i_dout;
