`timescale 100 ps/100 ps
module eth_rxdv_ddr(
	din,
	clk,
	q
);
input [0:0] din;
input clk;
output [1:0] q;
wire GND;
wire VCC;
wire clk;
wire [0:0] din;
wire [1:0] q;
VCC VCC_cZ (
  .V(VCC)
);
GND GND_cZ (
  .G(GND)
);
GSR GSR (
	.GSRI(VCC)
);
IDDR \iddr_gen[0].iddr_inst  (
	.D(din[0]),
	.CLK(clk),
	.Q0(q[0]),
	.Q1(q[1])
);
defparam \iddr_gen[0].iddr_inst .Q0_INIT=1'b0;
defparam \iddr_gen[0].iddr_inst .Q1_INIT=1'b0;
endmodule
